{
  "name": "prices",
  "item": "[class*=price],[itemprop=price],[data-price]",
  "description": "Every element that looks like a price, with the number pulled out and the nearest heading as context.",
  "fields": {
    "raw": {},
    "amount": {
      "regex": "[0-9][0-9,]*(?:\\.[0-9]+)?",
      "type": "number"
    },
    "currency": {
      "regex": "[$\u20ac\u00a3\u00a5]|USD|EUR|GBP"
    },
    "content": {
      "attr": "content|data-price"
    }
  }
}
